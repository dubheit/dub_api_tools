<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Personal Client Wizard Form View -->
    <record id="view_oauth2_personal_client_wizard_form" model="ir.ui.view">
        <field name="name">oauth2.personal_client.wizard.form</field>
        <field name="model">oauth2.personal_client.wizard</field>
        <field name="arch" type="xml">
            <form string="Create OAuth2 Credentials">
                <field name="user_id" invisible="1"/>
                <field name="client_created" invisible="1"/>
                <!-- Input form before creation -->
                <div invisible="client_created" class="mb-3">
                    <label for="name" class="fw-bold">Description</label>
                    <field name="name" placeholder="e.g., Claude Desktop, My App" class="w-100"/>
                </div>
                <!-- Results after creation -->
                <div invisible="not client_created">
                    <div class="alert alert-warning mb-4" role="alert">
                        <i class="fa fa-exclamation-triangle me-2" title="Warning"/>
                        <strong>Important:</strong> Copy these credentials now! The Client Secret will not be shown again.
                    </div>
                    <div class="row mb-3">
                        <span class="col-3 o_form_label fw-bold">Client ID</span>
                        <div class="col-9">
                            <field name="client_id" widget="CopyClipboardChar" class="w-100"/>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <span class="col-3 o_form_label fw-bold">Client Secret</span>
                        <div class="col-9">
                            <field name="client_secret" widget="CopyClipboardChar" class="w-100"/>
                        </div>
                    </div>
                    <hr/>
                    <h5 class="mt-3 mb-3">URLs</h5>
                    <div class="row mb-3">
                        <span class="col-3 o_form_label">Token URL</span>
                        <div class="col-9">
                            <field name="token_url" widget="CopyClipboardChar" class="w-100"/>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <span class="col-3 o_form_label">Authorization URL</span>
                        <div class="col-9">
                            <field name="authorization_url" widget="CopyClipboardChar" class="w-100"/>
                        </div>
                    </div>
                </div>
                <footer invisible="client_created">
                    <button name="action_create_client" type="object"
                            string="Create Credentials" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
                <footer invisible="not client_created">
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Extend User Form (admin view) -->
    <record id="view_users_form_oauth2" model="ir.ui.view">
        <field name="name">res.users.form.oauth2</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_security']" position="after">
                <page string="OAuth2 Credentials" name="oauth2_credentials">
                    <group>
                        <button name="action_create_personal_client" type="object"
                                string="Create New OAuth2 Credentials" class="btn-primary"
                                icon="fa-plus"/>
                    </group>
                    <field name="oauth2_personal_client_ids" nolabel="1"
                           context="{'default_service_account_user_id': id}">
                        <list create="0" delete="0">
                            <field name="name"/>
                            <field name="client_id"/>
                            <field name="active"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend User Preferences Form (personal preferences) -->
    <record id="view_users_preferences_oauth2" model="ir.ui.view">
        <field name="name">res.users.preferences.form.oauth2</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='api_keys']" position="after">
                <div name="oauth2_credentials" class="d-lg-flex mt-3">
                    <div class="col-lg-3 d-flex flex-column">
                        <label for="oauth2_personal_client_ids" string="OAuth2 Credentials" class="o_form_label"/>
                        <span class="text-muted">
                            For AI assistants (Claude, etc).
                        </span>
                    </div>
                    <div class="w-lg-75 d-flex flex-column my-auto">
                        <field name="oauth2_personal_client_ids" mode="kanban" invisible="not oauth2_personal_client_ids" class="w-lg-75">
                            <kanban create="0" delete="0">
                                <field name="name"/>
                                <field name="client_id"/>
                                <field name="active"/>
                                <templates>
                                    <t t-name="card">
                                        <div class="d-flex align-items-center">
                                            <field name="name" class="fw-bold flex-grow-1"/>
                                            <span class="badge me-2" t-att-class="record.active.raw_value ? 'text-bg-success' : 'text-bg-secondary'">
                                                <t t-if="record.active.raw_value">Active</t>
                                                <t t-else="">Revoked</t>
                                            </span>
                                            <button t-if="record.active.raw_value" name="action_revoke_personal" type="object"
                                                    class="btn btn-link text-danger p-0" title="Revoke">
                                                <i class="fa fa-trash"/>
                                            </button>
                                        </div>
                                        <div class="text-muted small">
                                            <field name="client_id"/>
                                        </div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                        <div>
                            <button name="action_create_personal_client" string="Add OAuth2 Credentials" type="object" class="btn btn-secondary h-100"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
