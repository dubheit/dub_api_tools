<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Scheduled action to cleanup expired tokens -->
    <record id="ir_cron_cleanup_oauth2_tokens" model="ir.cron">
        <field name="name">OAuth2: Cleanup Expired Tokens</field>
        <field name="model_id" ref="model_oauth2_access_token"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- Scheduled action to cleanup expired authorization codes -->
    <record id="ir_cron_cleanup_oauth2_codes" model="ir.cron">
        <field name="name">OAuth2: Cleanup Expired Codes</field>
        <field name="model_id" ref="model_oauth2_authorization_code"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>

    <!-- Scheduled action to deactivate dynamically registered clients nobody
         uses any more. Weekly, not daily: nothing here is urgent, and a slower
         cadence leaves more room to notice a wrong guess. -->
    <record id="ir_cron_cleanup_oauth2_stale_clients" model="ir.cron">
        <field name="name">OAuth2: Deactivate Unused Dynamic Clients</field>
        <field name="model_id" ref="model_oauth2_client"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_stale_clients()</field>
        <field name="interval_number">7</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
