<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_oauth2_manager" model="res.groups">
            <field name="name">OAuth2 Manager</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <!-- Users can see their own personal OAuth2 clients -->
        <record id="rule_personal_client_user" model="ir.rule">
            <field name="name">Personal OAuth2 Clients: own only</field>
            <field name="model_id" ref="model_oauth2_client"/>
            <field name="domain_force">[('service_account_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
        <!-- OAuth2 Managers can see all clients -->
        <record id="rule_oauth2_client_manager" model="ir.rule">
            <field name="name">OAuth2 Clients: manager full access</field>
            <field name="model_id" ref="model_oauth2_client"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_oauth2_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
